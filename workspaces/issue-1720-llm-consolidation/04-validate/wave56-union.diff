+                "engine.identifier_fit_skipped_non_sql_dialect",
+                extra={
+                    "database_type": database_type,
+                    "identifier_length": len(identifier),
+                    "reason": str(exc),
+                },
+            )
+            return identifier
+
+        return dialect.normalize_identifier(identifier)

