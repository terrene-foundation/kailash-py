    cls = _memory_model(ISSUE_MODEL_NAME)
    cls.__dataflow__ = {"indexes": [{"name": "", "fields": ["conversation_id"]}]}
    db = DataFlow(database_url="postgresql://u:p@localhost:5432/db")
