        names = [
            _INDEX_NAME_RE.match(sql).group(1)
            for sql in db._generate_indexes_sql(ISSUE_MODEL_NAME, "sqlite")
        ]

        assert names == [f"idx_{table}_conversation_id", f"idx_{table}_created_at"]


