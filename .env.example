# Kailash environment variable template.
#
# Copy this file to `.env` at the repo root and fill in real values.
# `.env` is git-ignored; `.env.example` is the documented contract that
# every Kailash deployment relies on for API keys and model identifiers.
#
# Per rules/env-models.md, model identifiers (and provider API keys)
# MUST come from .env. Hardcoded model literals like "gpt-4" or
# "claude-sonnet-4-6" in source code are BLOCKED — they lock deployments
# to a single provider/version and prevent per-environment model
# selection (cheap model in dev, capable model in prod).

# -- Default model for kaizen agents -----------------------------------------
# Used by CoreAgent (kaizen.core.agents.Agent) and GovernedSupervisor
# (kaizen_agents.supervisor.GovernedSupervisor) when the caller does not
# supply an explicit `model=` argument. If unset, those constructors raise
# kaizen.errors.EnvModelMissing with an actionable message rather than
# silently defaulting to a stale provider/version.
#
# Choose any model identifier supported by your configured provider
# (gpt-4o-mini, gpt-4o, claude-3-5-sonnet, claude-3-5-haiku, gemini-1.5-pro,
# llama3.1, ...). Pair it with the matching provider API key below.
KAIZEN_DEFAULT_MODEL=

# -- Provider API keys --------------------------------------------------------
# Set whichever pair matches the provider implied by KAIZEN_DEFAULT_MODEL.
# Per rules/env-models.md model-key pairings:
#   gpt-* / o1-* / o3-* / o4-*   → OPENAI_API_KEY
#   claude-*                     → ANTHROPIC_API_KEY
#   gemini-*                     → GOOGLE_API_KEY (or GEMINI_API_KEY)
#   deepseek-*                   → DEEPSEEK_API_KEY
#   mistral-* / mixtral-*        → MISTRAL_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# -- Secret encryption --------------------------------------------------------
# Key material for kailash.gateway.security.SecretManager, which encrypts
# credentials before handing them to whichever backend it was given.
#
# There is deliberately NO default. With this unset and no encryption_key=
# passed, SecretManager refuses to encrypt or decrypt and logs a one-time
# ERROR at construction naming this variable. Releases up to kailash 2.63
# generated a throwaway key here and continued at WARNING level, which made
# every secret the process wrote unrecoverable after a restart (#2041).
#
# This is a PASSPHRASE, not a Fernet key: any string of at least 32 characters
# works, stretched with PBKDF2-HMAC-SHA256 over a salt generated per secret and
# stored beside the ciphertext. A value that is already a valid Fernet key is
# also accepted, and is additionally used to read secrets written by kailash
# <= 2.63.
#
# Losing this value means losing every secret encrypted under it. Back it up
# wherever the rest of your key material lives, and rotate by re-storing each
# secret under the new value.
KAILASH_ENCRYPTION_KEY=

# Set to 1 to treat secret encryption as mandatory. Two effects: a missing
# KAILASH_ENCRYPTION_KEY becomes a start-up failure instead of a logged error,
# AND every value read back must arrive sealed in the current envelope format.
#
# That second half matters. By default an UNSEALED value is returned exactly as
# the backend supplied it, with no integrity check -- which is what lets the
# manager work with backends holding values nobody sealed, but means anyone who
# can write the backing store can swap a sealed value for plain text and have
# it returned unauthenticated. Strict mode refuses that, and also refuses the
# pre-2.64 `encrypted:` format, which carries no reference binding.
#
# SecretManager() is constructed by default inside EnhancedDurableAPIGateway and
# EnterpriseWorkflowServer, so this is the only way to demand fail-fast without
# editing those call sites. Recommended for any deployment that actually stores
# secrets through the gateway.
KAILASH_REQUIRE_SECRET_ENCRYPTION=

# Master key for kailash.gateway.security.FileSecretBackend, which encrypts
# each secret into its own file. Separate from KAILASH_ENCRYPTION_KEY so the
# at-rest key and the manager's key can be rotated independently. Also at
# least 32 characters; the backend raises at construction without it (#2024).
KAILASH_SECRETS_MASTER_KEY=

# Where FileSecretBackend keeps its rollback high-water-mark manifest.
# Defaults to the secrets directory itself, which means a whole-directory
# restore reverts the marks along with the secrets and is NOT detected as a
# rollback. Point this at a directory with an independent backup lifecycle to
# close that case.
KAILASH_SECRETS_STATE_DIR=

# HS256 signing secret for kailash.middleware.auth.JWTAuthManager.
#
# There is deliberately NO default. Releases up to kailash 2.64 shipped
# JWTConfig.auto_generate_keys=True, so a manager with nothing configured minted
# a throwaway secret and continued at INFO level: every token died at the next
# restart, and in a multi-replica deployment each replica signed with a
# different secret, so a token issued by one was rejected by the next --
# intermittently, depending on which replica the load balancer picked (#2083).
# That default is now False, and an unconfigured manager raises.
#
# At least 32 characters (RFC 7518 section 3.2 requires 256 bits for
# HMAC-SHA256). Leading and trailing whitespace IS significant: the length is
# measured trimmed but the secret is used verbatim, so a stray newline changes
# the signing key and every previously-issued token stops verifying.
#
# That is a LENGTH floor, not an ENTROPY floor: 32 repeats of one character
# clears it. It rules out the weakest configurations; it does not make a
# guessable secret safe. Generate one rather than composing it:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
#
# Every replica that must accept each other's tokens needs the SAME value.
KAILASH_JWT_SECRET_KEY=

# Key material for kaizen.security.encryption (EncryptionProvider, KeyManager,
# FieldEncryptor) and kaizen.core.autonomy CheckpointEncryptor. Also reachable
# as KaizenConfig.encryption_key.
#
# There is deliberately NO default. Up to kaizen 0.9 an unconfigured provider
# generated an AES-256-GCM key in COMPLETE silence -- no error, no warning, not
# even an INFO line -- so anything encrypted became unrecoverable once the
# process exited, and the first symptom was unreadable data with nothing in the
# logs pointing at why (#2092).
#
# A passphrase of at least 32 characters, stretched with PBKDF2-HMAC-SHA256, or
# exactly 32 raw bytes. An empty value counts as UNSET, never as a passphrase.
#
# That is a LENGTH floor, not an ENTROPY floor: 32 repeats of one character
# clears it, and no iteration count rescues a guessable passphrase. Generate
# one rather than composing it:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
#
# Losing this value means losing everything encrypted under it.
KAIZEN_ENCRYPTION_KEY=

# PEM private key used by kailash_mcp.auth.oauth.JWTManager to SIGN OAuth 2.1
# access and refresh tokens.
#
# There is deliberately NO default. Previously an unconfigured JWTManager
# generated an RSA key pair silently, and both AuthorizationServer and
# ResourceServer default-construct one -- so tokens stopped verifying after a
# restart and every other replica rejected them. Signing now raises instead.
#
# Every replica in an OAuth deployment needs the SAME key pair.
KAILASH_MCP_JWT_PRIVATE_KEY=

# PEM public key used by kailash_mcp.auth.oauth.JWTManager to VERIFY tokens.
# Optional when KAILASH_MCP_JWT_PRIVATE_KEY is set: the public half is derived
# from it. Set explicitly on a resource server that verifies tokens it does not
# mint, so the private key never has to reach that process at all.
KAILASH_MCP_JWT_PUBLIC_KEY=
