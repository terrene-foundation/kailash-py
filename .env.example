# Kailash environment variable template.
#
# Copy this file to `.env` at the repo root and fill in real values.
# `.env` is git-ignored; `.env.example` is the documented contract that
# every Kailash deployment relies on for API keys and model identifiers.
#
# Per rules/env-models.md, model identifiers (and provider API keys)
# MUST come from .env. Hardcoded model literals like "gpt-4" or
# "claude-sonnet-4-6" in source code are BLOCKED — they lock deployments
# to a single provider/version and prevent per-environment model
# selection (cheap model in dev, capable model in prod).

# -- Default model for kaizen agents -----------------------------------------
# Used by CoreAgent (kaizen.core.agents.Agent) and GovernedSupervisor
# (kaizen_agents.supervisor.GovernedSupervisor) when the caller does not
# supply an explicit `model=` argument. If unset, those constructors raise
# kaizen.errors.EnvModelMissing with an actionable message rather than
# silently defaulting to a stale provider/version.
#
# Choose any model identifier supported by your configured provider
# (gpt-4o-mini, gpt-4o, claude-3-5-sonnet, claude-3-5-haiku, gemini-1.5-pro,
# llama3.1, ...). Pair it with the matching provider API key below.
KAIZEN_DEFAULT_MODEL=

# -- Provider API keys --------------------------------------------------------
# Set whichever pair matches the provider implied by KAIZEN_DEFAULT_MODEL.
# Per rules/env-models.md model-key pairings:
#   gpt-* / o1-* / o3-* / o4-*   → OPENAI_API_KEY
#   claude-*                     → ANTHROPIC_API_KEY
#   gemini-*                     → GOOGLE_API_KEY (or GEMINI_API_KEY)
#   deepseek-*                   → DEEPSEEK_API_KEY
#   mistral-* / mixtral-*        → MISTRAL_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# -- Secret encryption --------------------------------------------------------
# Key material for kailash.gateway.security.SecretManager, which encrypts
# credentials before handing them to whichever backend it was given.
#
# There is deliberately NO default. With this unset and no encryption_key=
# passed, SecretManager refuses to encrypt or decrypt and logs a one-time
# ERROR at construction naming this variable. Releases up to kailash 2.63
# generated a throwaway key here and continued at WARNING level, which made
# every secret the process wrote unrecoverable after a restart (#2041).
#
# This is a PASSPHRASE, not a Fernet key: any string of at least 32 characters
# works, stretched with PBKDF2-HMAC-SHA256 over a salt generated per secret and
# stored beside the ciphertext. A value that is already a valid Fernet key is
# also accepted, and is additionally used to read secrets written by kailash
# <= 2.63.
#
# Losing this value means losing every secret encrypted under it. Back it up
# wherever the rest of your key material lives, and rotate by re-storing each
# secret under the new value.
KAILASH_ENCRYPTION_KEY=

# Set to 1 to make a missing KAILASH_ENCRYPTION_KEY a start-up failure instead
# of a logged error. SecretManager() is constructed by default inside
# EnhancedDurableAPIGateway and EnterpriseWorkflowServer, so this is the only
# way to demand fail-fast without editing those call sites. Recommended for
# any deployment that actually stores secrets through the gateway.
KAILASH_REQUIRE_SECRET_ENCRYPTION=

# Master key for kailash.gateway.security.FileSecretBackend, which encrypts
# each secret into its own file. Separate from KAILASH_ENCRYPTION_KEY so the
# at-rest key and the manager's key can be rotated independently. Also at
# least 32 characters; the backend raises at construction without it (#2024).
KAILASH_SECRETS_MASTER_KEY=

# Where FileSecretBackend keeps its rollback high-water-mark manifest.
# Defaults to the secrets directory itself, which means a whole-directory
# restore reverts the marks along with the secrets and is NOT detected as a
# rollback. Point this at a directory with an independent backup lifecycle to
# close that case.
KAILASH_SECRETS_STATE_DIR=
