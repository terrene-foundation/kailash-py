{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/lib/codex-hook-runtime.js\" ./.claude/hooks/session-start.js",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/lib/codex-hook-runtime.js\" ./.claude/hooks/validate-bash-command.js",
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionRequest": [],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/lib/codex-hook-runtime.js\" ./.claude/hooks/integration-hygiene.js",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": []
  }
}
